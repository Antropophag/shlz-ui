{
  "$schema": "./token-schema.json",
  "color": {
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F5F5F5",
      "100": "#EEF0F4",
      "200": "#DFE2F0",
      "300": "#D1D8DF",
      "500": "#939CA5",
      "900": "#0B1623"
    },
    "brand": {
      "300": "#7383BE",
      "500": "#425BA6",
      "600": "#253D98",
      "700": "#162773"
    },
    "green": { "500": "#57965C" },
    "red": { "500": "#CC1F1F" }
  },
  "semantic": {
    "text": {
      "primary": "{color.neutral.900}",
      "muted": "{color.neutral.500}",
      "inverse": "{color.neutral.0}"
    },
    "surface": {
      "base": "{color.neutral.0}",
      "subtle": "{color.neutral.50}",
      "muted": "{color.neutral.100}"
    },
    "border": { "default": "{color.neutral.300}" },
    "action": {
      "primary": "{color.brand.600}",
      "primary-hover": "{color.brand.500}",
      "primary-active": "{color.brand.700}",
      "disabled": "{color.brand.300}"
    },
    "status": { "success": "{color.green.500}", "danger": "{color.red.500}" }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "radius": {
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "pill": "999px"
  },
  "border": { "thin": "1px", "icon": "1.5px" },
  "opacity": { "disabled": "0.5", "overlay": "0.75" },
  "shadow": { "surface": "0 1px 3px rgb(37 61 152 / 5%)" },
  "control": { "height-sm": "32px", "height-md": "40px" }
}
