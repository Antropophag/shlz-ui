{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["source", "semantic"],
  "properties": {
    "source": {
      "type": "object",
      "required": ["color", "spacing", "radius"]
    },
    "semantic": {
      "type": "object",
      "required": [
        "color",
        "font",
        "typography",
        "border",
        "opacity",
        "control"
      ]
    }
  },
  "additionalProperties": false
}
