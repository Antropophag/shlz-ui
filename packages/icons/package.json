{
  "name": "@shlz/icons",
  "version": "0.1.1",
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest.json": "./dist/manifest.json",
    "./compatibility-aliases.json": "./dist/compatibility-aliases.json",
    "./sprite.svg": "./dist/sprite.svg",
    "./icons/*": "./dist/icons/*",
    "./file-types/*": "./dist/file-types/*"
  },
  "scripts": {
    "build": "node -e \"import('./dist/index.js')\""
  }
}
