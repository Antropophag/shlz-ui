{
  "name": "shlz-ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run generate && npm run dev -w @shlz/showcase",
    "generate": "node tools/generate.mjs",
    "build": "npm run generate && npm run build --workspaces --if-present",
    "test": "node --test tools/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "eslint . && stylelint 'packages/**/*.css' 'apps/**/*.css' && prettier --check .",
    "check": "npm run generate && npm run test && npm run lint && npm run build && node tools/validate.mjs && npm run test:e2e",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.1"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
