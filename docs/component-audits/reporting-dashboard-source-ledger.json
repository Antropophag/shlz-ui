  "repositoryDecisions": [
    "Dashboard grid reflows to one column when available inline size cannot preserve supported widget content.",
    "Widget text uses semantic SHLZ typography because source glyphs are outlined.",
    "The chart plot slot is consumer-owned until a separate accessible chart contract exists."
  ],
