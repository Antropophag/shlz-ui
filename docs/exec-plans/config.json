{
  "version": 1,
  "sizing": {
    "weights": {
      "independentWorkUnits": 2,
      "sharedSeams": 3,
      "contracts": 2,
      "consumerIntegrations": 2,
      "evidenceLevels": 1,
      "architectureAmbiguity": 3,
      "changedScope": 2,
      "reviewRisk": 2,
      "contextGrowthRisk": 3
    },
    "bands": { "S": 0, "M": 16, "L": 32, "XL": 52 },
    "decompositionRequired": ["L", "XL"],
    "taskRegroupThreshold": 12
  },
  "context": {
    "unit": "tokens-when-runtime-supplied; otherwise proxy-observations",
    "normalTarget": [40000, 70000],
    "pressure": [60000, 80000],
    "redZone": [80000, 100000],
    "decomposeSignal": 100000,
    "semanticBoundaries": [
      "implementation-to-independent-review",
      "subsystem-change",
      "major-replan",
      "irrelevant-output-accumulation"
    ]
  },
  "validationTargets": {
    "docs": {
      "level": 1,
      "command": "npx prettier --check --ignore-unknown",
      "expensive": false,
      "fingerprintPatterns": ["AGENTS.md", "docs/**"]
    },
    "openspec": {
      "level": 1,
      "command": "npm run check:openspec",
      "expensive": false,
      "fingerprintPatterns": ["openspec/**", ".agents/skills/**"]
    },
    "harness": {
      "level": 1,
      "command": "npm run test:harness",
      "expensive": false,
      "fingerprintPatterns": [
        "tools/harness.mjs",
        "tools/lib/harness/**",
        "tools/tests/harness.test.mjs",
        "docs/exec-plans/**"
      ],
      "fingerprintIgnorePatterns": ["docs/exec-plans/active/**"]
    },
    "audit-manifest": {
      "level": 1,
      "command": "node --test tools/tests/component-audit-manifest.test.mjs",
      "expensive": false,
      "fingerprintPatterns": [
        "docs/component-audits/**",
        "tools/tests/component-audit-manifest.test.mjs"
      ]
    },
    "modal-unit": {
      "level": 1,
      "command": "node --test tools/tests/overlay-source.test.mjs",
      "expensive": false,
      "fingerprintPatterns": [
        "packages/behaviors/src/{modal,internal/native-dialog}.ts",
        "packages/styles/components/modal.css",
        "tools/tests/overlay-source.test.mjs"
      ]
    },
    "modal-browser": {
      "level": 2,
      "command": "playwright test tools/playwright/overlay.spec.js -g Modal",
      "expensive": true,
      "fingerprintPatterns": [
        "packages/behaviors/src/{modal,internal/native-dialog}.ts",
        "packages/styles/components/modal.css",
        "apps/showcase/**",
        "tools/playwright/overlay.spec.js"
      ]
    },
    "drawer-browser": {
      "level": 2,
      "command": "playwright test tools/playwright/overlay.spec.js -g Drawer",
      "expensive": true,
      "fingerprintPatterns": [
        "packages/behaviors/src/{drawer,internal/native-dialog}.ts",
        "packages/styles/components/drawer.css",
        "apps/showcase/**",
        "tools/playwright/{overlay,consumer-workspace}.spec.js"
      ]
    },
    "overlay-integration": {
      "level": 3,
      "command": "playwright test tools/playwright/overlay.spec.js",
      "expensive": true,
      "fingerprintPatterns": [
        "packages/behaviors/src/{modal,drawer,internal/native-dialog}.ts",
        "packages/styles/components/{modal,drawer}.css",
        "apps/showcase/**",
        "tools/playwright/overlay.spec.js"
      ]
    },
    "full-browser": {
      "level": 4,
      "command": "npm run test:e2e",
      "expensive": true,
      "fingerprintPatterns": [
        "apps/**",
        "packages/**",
        "tools/playwright/**",
        "playwright.config.*",
        "package*.json"
      ]
    },
    "full": {
      "level": 4,
      "command": "npm run check",
      "expensive": true,
      "fingerprintPatterns": ["**"]
    }
  },
  "validationRules": [
    { "patterns": ["AGENTS.md", "docs/**/*.md"], "targets": ["docs"] },
    {
      "patterns": ["openspec/**", ".agents/skills/**"],
      "targets": ["openspec"]
    },
    {
      "patterns": [
        "tools/harness.mjs",
        "tools/lib/harness/**",
        "tools/tests/harness.test.mjs",
        "docs/exec-plans/**"
      ],
      "targets": ["harness"]
    },
    { "patterns": ["docs/component-audits/**"], "targets": ["audit-manifest"] },
    {
      "patterns": [
        "packages/behaviors/src/modal.ts",
        "packages/styles/components/modal.css",
        "apps/showcase/src/**modal**"
      ],
      "targets": ["modal-unit", "modal-browser"]
    },
    {
      "patterns": [
        "packages/behaviors/src/drawer.ts",
        "packages/styles/components/drawer.css",
        "apps/showcase/src/**drawer**"
      ],
      "targets": ["drawer-browser"]
    },
    {
      "patterns": ["packages/behaviors/src/internal/native-dialog.ts"],
      "targets": [
        "modal-unit",
        "modal-browser",
        "drawer-browser",
        "overlay-integration"
      ]
    },
    {
      "patterns": ["apps/showcase/src/consumer-workspace.js"],
      "targets": ["drawer-browser"]
    },
    {
      "patterns": ["tools/playwright/overlay.spec.js"],
      "targets": ["overlay-integration"]
    }
  ]
}
